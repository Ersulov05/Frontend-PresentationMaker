<header class="header">
    <div class="top-bar">
        <img class="top-bar__logo" src="/images/pizzeria_logo_black.svg" alt="pizzeria logo">
        <nav class="top-bar__navigation">
            <ul class="top-bar__navigation-list">
                <li class="top-bar__navigation-item">
                    <a class="top-bar__navigation-link" href="/catalog">
                        <img class="top-bar__navigation-image" src="/images/eye.svg" alt="">
                        <p class="top-bar__navigation-text">Catalog</p>
                    </a>
                </li>
                <li class="top-bar__navigation-item">
                    <a class="top-bar__navigation-link" href="/profile">
                        <img class="top-bar__navigation-image" src="/images/eye.svg" alt="">
                        <p class="top-bar__navigation-text">Profile</p>
                    </a>
                </li>
                <li class="top-bar__navigation-item">
                    <a class="top-bar__navigation-link" href="/basket">
                        <img class="top-bar__navigation-image" src="/images/eye.svg" alt="">
                        <p class="top-bar__navigation-text">Basket</p>
                        <div class="top-bar__basket-count">{{ user.getBasket | length}}</div>
                    </a>
                </li>
            </ul>
        </nav>
    </div> 
</header>