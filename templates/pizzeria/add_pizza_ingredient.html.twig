<li class="ingredient" data-ingredient-id="{{ ingredient.getId }}">
    <p class="ingredient__name">{{ ingredient.getName}}</p>
    <div class="ingredient__top-block">
        <img class="ingredient__image" src="/images/ingredient/{{ ingredient.getImagePath }}" alt="pizza ingredient">
        <input type="text" class="ingredient__input-gramm" placeholder="Gramm" disabled="true">
        <p class="ingredient__gramm-text">г</p>
    </div>
</li>