<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\OrderedPizza" table="ordered_pizzas">
        <id name="orderedPizzaId" type="integer" column="ordered_pizza_id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="orderId" type="integer" column="order_id"/>
        <field name="pizzaName" type="string" column="pizza_name"/>
        <field name="pizzaDiameter" type="integer" column="pizza_diameter"/>
        <field name="pizzaDough" type="string" column="pizza_dough"/>
        <field name="pizzaCount" type="integer" column="pizza_count"/>
        <field name="pizzaPrice" type="integer" column="pizza_price"/>

        <many-to-one field="order" target-entity="Order" inversed-by="orderedPizzas">
            <join-column name="order_id" referenced-column-name="order_id"/>
        </many-to-one>
    </entity>
</doctrine-mapping>