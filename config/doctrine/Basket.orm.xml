<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Basket" table="baskets">
        <id name="userId" type="integer" column="user_id"/>
        <id name="pizzaId" type="integer" column="pizza_id"/>
        <id name="pizzaDiameter" type="integer" column="pizza_diameter"/>
        <id name="pizzaDough" type="string" column="pizza_dough"/>
        <field name="pizzaCount" type="integer" column="pizza_count"/>

        <many-to-one field="user" target-entity="User" inversed-by="basket">
            <join-column name="user_id" referenced-column-name="user_id"/>
        </many-to-one>
        <many-to-one field="pizza" target-entity="Pizza" inversed-by="basket">
            <join-column name="pizza_id" referenced-column-name="pizza_id"/>
        </many-to-one>
    </entity>
</doctrine-mapping>