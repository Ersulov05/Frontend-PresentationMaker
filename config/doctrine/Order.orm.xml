<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Order" table="orders">
        <id name="orderId" type="integer" column="order_id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="userId" type="integer" column="user_id"/>
        <field name="orderDeliveryAddress" type="string" column="order_delivery_address" length="255"/>
        <field name="orderDate" type="datetime" column="order_date"/>
        <field name="orderIsComplete" type="boolean" column="order_is_complete"/>
        <one-to-many field="orderedPizzas" target-entity="OrderedPizza" mapped-by="order"/>
        <many-to-one field="user" target-entity="User" inversed-by="orders">
            <join-column name="user_id" referenced-column-name="user_id"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
